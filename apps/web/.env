# Single env for ALL build modes (dev, staging, production). There is no
# .env.production / .env.staging split - this one file is the source of truth.
#
# These are inherited Uniswap PUBLIC dev keys: fine for local dev, but see the
# README "Environment variables" section + launch checklist before deploying to
# your own domain. Before a public launch, swap the WalletConnect project ID
# (the inherited one is allowlisted to Uniswap's domains and will reject yours)
# and the Privy project for your own.
APP_ID=web
REACT_APP_AWS_API_ENDPOINT="https://interface.gateway.uniswap.org/v1/graphql"
REACT_APP_INFURA_KEY="099fc58e0de9451d80b18d7c74caa7c1"
REACT_APP_QUICKNODE_ENDPOINT_NAME="tame-frequent-fog"
REACT_APP_QUICKNODE_ENDPOINT_TOKEN="774f0081965a0e9378059e0622c2a584fb8859f2"
REACT_APP_STATSIG_API_KEY="statsig_api_key"
REACT_APP_UNISWAP_GATEWAY_DNS="https://interface.gateway.uniswap.org/v2"
REACT_APP_WALLET_CONNECT_PROJECT_ID="c6c9bacd35afa3eb9e6cccf6d8464395"
REACT_APP_TRADING_API_KEY="TRADING_API_KEY"
VITE_ENABLE_ENTRY_GATEWAY_PROXY=false
REACT_APP_ANALYTICS_ENABLED=true
